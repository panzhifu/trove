{
  "manifest_version": 3,
  "name": "Trove 采集器",
  "version": "1.1.0",
  "description": "把网页图片一键存进本地 Trove 素材库。",
  "browser_specific_settings": {
    "gecko": {
      "id": "trove-collector@trove.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trove 采集器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}