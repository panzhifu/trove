{
  "manifest_version": 3,
  "name": "Trove 采集器",
  "version": "1.2.0",
  "description": "把网页图片或视频存进本地 Trove 素材库，可指定合集；支持右键与拖拽保存。",
  "browser_specific_settings": {
    "gecko": {
      "id": "trove-collector@trove.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "scripting",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "preferences.js",
      "collections.js",
      "hotlink-sites.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "preferences.js",
        "collections.js",
        "media-target.js",
        "save-bubble.js",
        "tree-menu.js",
        "content-script.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trove 采集器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
