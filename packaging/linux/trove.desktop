[Desktop Entry]
Type=Application
Name=Trove
GenericName=Asset Manager
Comment=Local-first asset library: images, video, fonts, 3D models
Exec=trove-app
Icon=trove
Categories=Graphics;Utility;FileManager;
StartupWMClass=trove
Keywords=assets;images;fonts;collection;
# KWin authorizes `org.kde.KWin.ScreenShot2` (in-process capture on KDE)
# only for applications whose desktop entry declares the interface here.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
